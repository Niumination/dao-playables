{
  "version": 2,
  "name": "dao-playables",
  "public": true,
  "builds": [
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/circuit/assets/(.*)",
      "dest": "/apps/circuit/dist/assets/$1"
    },
    {
      "src": "/chaos/assets/(.*)",
      "dest": "/apps/chaos/dist/assets/$1"
    },
    {
      "src": "/gather/assets/(.*)",
      "dest": "/apps/gather/dist/assets/$1"
    },
    {
      "src": "/pandora/assets/(.*)",
      "dest": "/apps/pandora/dist/assets/$1"
    },
    {
      "src": "/wake/assets/(.*)",
      "dest": "/apps/wake/dist/assets/$1"
    },
    {
      "src": "/circuit",
      "dest": "/apps/circuit/dist/index.html"
    },
    {
      "src": "/chaos",
      "dest": "/apps/chaos/dist/index.html"
    },
    {
      "src": "/gather",
      "dest": "/apps/gather/dist/index.html"
    },
    {
      "src": "/pandora",
      "dest": "/apps/pandora/dist/index.html"
    },
    {
      "src": "/wake",
      "dest": "/apps/wake/dist/index.html"
    },
    {
      "src": "/",
      "dest": "/apps/circuit/dist/index.html"
    }
  ]
}