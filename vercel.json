{
  "version": 2,
  "name": "dao-playables",
  "public": true,
  "builds": [
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/circuit",
      "destination": "/circuit/"
    },
    {
      "source": "/chaos",
      "destination": "/chaos/"
    },
    {
      "source": "/gather",
      "destination": "/gather/"
    },
    {
      "source": "/pandora",
      "destination": "/pandora/"
    },
    {
      "source": "/wake",
      "destination": "/wake/"
    },
    {
      "source": "/",
      "destination": "/circuit/"
    }
  ]
}