{
  "version": 2,
  "name": "dao-playables",
  "public": true,
  "functions": {
    "apps/*/dist/index.html": {
      "runtime": "@vercel/static@3.2.6"
    },
    "apps/*/dist/assets/**": {
      "runtime": "@vercel/static@3.2.6"
    }
  },
  "rewrites": [
    {
      "source": "/circuit/(.*)",
      "destination": "/apps/circuit/dist/$1"
    },
    {
      "source": "/circuit",
      "destination": "/apps/circuit/dist/index.html"
    },
    {
      "source": "/chaos/(.*)",
      "destination": "/apps/chaos/dist/$1"
    },
    {
      "source": "/chaos",
      "destination": "/apps/chaos/dist/index.html"
    },
    {
      "source": "/gather/(.*)",
      "destination": "/apps/gather/dist/$1"
    },
    {
      "source": "/gather",
      "destination": "/apps/gather/dist/index.html"
    },
    {
      "source": "/pandora/(.*)",
      "destination": "/apps/pandora/dist/$1"
    },
    {
      "source": "/pandora",
      "destination": "/apps/pandora/dist/index.html"
    },
    {
      "source": "/wake/(.*)",
      "destination": "/apps/wake/dist/$1"
    },
    {
      "source": "/wake",
      "destination": "/apps/wake/dist/index.html"
    },
    {
      "source": "/",
      "destination": "/apps/circuit/dist/index.html"
    }
  ]
}