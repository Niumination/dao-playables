{
  "version": 2,
  "name": "dao-playables",
  "public": true,
  "builds": [
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/circuit",
      "dest": "/apps/circuit/dist/index.html"
    },
    {
      "src": "/chaos",
      "dest": "/apps/chaos/dist/index.html"
    },
    {
      "src": "/gather",
      "dest": "/apps/gather/dist/index.html"
    },
    {
      "src": "/pandora",
      "dest": "/apps/pandora/dist/index.html"
    },
    {
      "src": "/wake",
      "dest": "/apps/wake/dist/index.html"
    },
    {
      "src": "/",
      "dest": "/apps/circuit/dist/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/circuit/(.*)",
      "dest": "/apps/circuit/dist/$1"
    },
    {
      "src": "/chaos/(.*)",
      "dest": "/apps/chaos/dist/$1"
    },
    {
      "src": "/gather/(.*)",
      "dest": "/apps/gather/dist/$1"
    },
    {
      "src": "/pandora/(.*)",
      "dest": "/apps/pandora/dist/$1"
    },
    {
      "src": "/wake/(.*)",
      "dest": "/apps/wake/dist/$1"
    }
  ]
}